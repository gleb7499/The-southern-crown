{
  "name": "southern-crown-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Административная панель управления фермой - монорепозиторий",
  "scripts": {
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:lint": "cd frontend && npm run lint",
    "frontend:lint:fix": "cd frontend && npm run lint:fix",
    "frontend:format": "cd frontend && npm run format",
    "backend:dev": "cd backend && uvicorn app.main:app --reload",
    "backend:lint": "cd backend && black --check . && isort --check-only . && flake8 .",
    "backend:format": "cd backend && black . && isort .",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore frontend/node_modules",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --ignore frontend/node_modules --fix",
    "lint": "npm run frontend:lint && npm run backend:lint && npm run lint:md",
    "format": "npm run frontend:format && npm run backend:format && npm run lint:md:fix",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "markdownlint-cli": "^0.38.0"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx}": [
      "cd frontend && eslint --fix",
      "cd frontend && prettier --write"
    ],
    "frontend/**/*.{json,css}": [
      "cd frontend && prettier --write"
    ],
    "backend/**/*.py": [
      "python -m black",
      "python -m isort",
      "python -m flake8 --max-line-length=100 --extend-ignore=E501,E203,W503,C901,F401,E402"
    ],
    "**/*.md": [
      "markdownlint --fix"
    ],
    "**/*.{yml,yaml}": [
      "prettier --write"
    ]
  }
}
